# 数据库
# 统一基线仅使用 MySQL 8.4；通过 A22_DB_PASSWORD 或 MYSQL_ROOT_PASSWORD 注入密码。
MYSQL_ROOT_PASSWORD=
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3307/a22?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=
A22_DB_PASSWORD=

# Local OceanBase sink (optional; start with: docker compose up -d oceanbase)
OCEANBASE_PASSWORD=
OCEANBASE_JDBC_URL=jdbc:mysql://127.0.0.1:2881/a22?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai
OCEANBASE_USERNAME=root@test
OCEANBASE_DATABASE=a22

# Local HDFS-compatible filesystem mode (no SSH tunnel or ECS required)
HDFS_DEFAULT_FS=file:///

# Flink / Kafka / Redis
# CSV 单机基线只启动 MySQL 和 Redis；Kafka/Flink 使用 docker compose --profile streaming。
FLINK_REST_URL=http://127.0.0.1:8081
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Flink 作业
FLINK_JOB_JAR=
FLINK_MYSQL_URL=
FLINK_MYSQL_USERNAME=root
FLINK_MYSQL_PASSWORD=

# AI 助手
AI_API_KEY=

# SSH 隧道
A22_SSH_PASSWORD=
A22_SSH_TARGET_HOST=
